# ==========================================
# nonebot-plugin-jmcomic 插件配置示例
# ==========================================

# 网络代理设置（若本地运行 Clash/v2ray，可填 http://127.0.0.1:7890）
JM_PROXY=

# 客户端实现模式：api（推荐，APP端接口免梯稳定性高）或 html（网页端）
JM_CLIENT_IMPL=api

# 本子与 PDF 下载保存根目录
JM_DOWNLOAD_DIR=data/jmcomic/downloads

# 临时图片缓存目录
JM_CACHE_DIR=cache/jmcomic

# 单次预览最大张数（防风控建议 3~5 张）
JM_MAX_PREVIEW_PAGES=5

# 是否仅限管理员/超级用户使用 ZIP 下载（true/false）
JM_ADMIN_ONLY_DOWNLOAD=true

# 是否允许群聊使用（true/false）
JM_ALLOW_GROUP=true

# 普通用户冷却 CD（秒）
JM_CD=5

# 禁漫账号 AVS Cookie（可选，用于解锁需登录或特殊题材漫画）
JM_COOKIES_AVS=
